{
  "expo": {
    "name": "GoSafe",
    "slug": "gosafe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/app_icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/logos/splash_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gosafe.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/adaptive_icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gosafe.mobile"
    },
    "web": {
      "favicon": "./src/assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "gosafe"
  }
}
